{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": ["server.ts", "tui.tsx", "src", "tests", "scripts"]
}
